# Contact form delivery. The form on /contact only appears when at least one
# of these is configured (Resend, or Supabase URL + service role key).

# Supabase (stores submissions in a `messages` table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications)
RESEND_API_KEY=
# Defaults to the site email in src/content/site.ts
CONTACT_TO_EMAIL=
# Defaults to Resend's onboarding sender; use an address on a domain verified in Resend
CONTACT_FROM_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=https://abdalrahman-elgazzawi.vercel.app
